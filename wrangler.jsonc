{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-grocer-beta",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-17",
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
